# 서버
PORT=4000
NODE_ENV=development

# 프론트엔드 주소 (Netlify). 승인 메일 링크와 승인 결과 리다이렉트에 사용
APP_URL=http://localhost:5173

# 32자 이상 임의 문자열 (예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Turso. 로컬 개발은 file:local.db 로 파일 DB를 쓸 수 있음
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Cloudflare R2. 비워두면 backend/.uploads 폴더에 저장 (로컬 개발용)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 버킷에 공개 커스텀 도메인을 붙였다면 입력 (비우면 서명된 URL 사용)
R2_PUBLIC_URL=

# 가입 승인 메일을 받을 관리자
ADMIN_EMAIL=admin@example.com

# Resend (https://resend.com). 비워두면 메일 내용을 서버 로그로 출력
RESEND_API_KEY=
MAIL_FROM=우리가족 <onboarding@resend.dev>
