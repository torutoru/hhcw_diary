{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "vite-plugin-pwa/react"]
  },
  "include": ["src", "vite.config.ts"],
  // 서비스 워커는 브라우저 창이 아니라 워커에서 돌아서 tsconfig.sw.json 으로 따로 검사한다
  "exclude": ["src/sw.ts"]
}
